--Find employees whose salary is higher than their department's average salary.
WITH dept_avg AS (
    SELECT department, AVG(salary) AS [Department Average] FROM employees GROUP BY department
)
SELECT
    e.name,
    e.department,
    e.salary,
    d.[Department Average]
FROM employees e JOIN dept_avg d ON e.department = d.department WHERE e.salary > d.[Department Average];

--Find the top 3 highest-paid employees in the entire company using a CTE.
with top_3 as (
    select name, department, salary, ROW_NUMBER() over(
        order by salary desc
    ) as salary_rank2
    from employees
)
select name, department, salary from top_3 where salary_rank2 <=3

--Find the department that has the highest average salary.
WITH dept_avg AS (
    SELECT department, AVG(salary) AS Average_Salary FROM employees GROUP BY department
),
ranked_dept AS (
    SELECT department, Average_Salary, DENSE_RANK() OVER ( ORDER BY Average_Salary DESC
        ) AS avg_rank
    FROM dept_avg
)
SELECT
    department,
    Average_Salary
FROM ranked_dept
WHERE avg_rank = 1;

