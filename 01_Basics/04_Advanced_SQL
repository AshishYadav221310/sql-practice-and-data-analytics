----------------------- CTE---------------------

--Find the top 2 highest-paid employees in every department.
with ranked_employees as (
    select name, department, salary,
    DENSE_RANK() over(partition by department order by salary desc) as salary_Rank
    from employees
)
select name, department, salary from ranked_employees where salary_Rank <=2

--Q1. Find the highest-paid employee from each department using a CTE + DENSE_RANK()
with highest_paid as (
    select name, department, salary,
    DENSE_RANK() over(partition by department order by salary desc) as salary_rank
    from employees
)
select name, department, salary from highest_paid where salary_rank = 1

